# Development defaults (local docker-compose.yml)
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aippt?sslmode=disable"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aippt?sslmode=disable"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
REDIS_URL="redis://localhost:6380"

POSTGRES_DB="aippt"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/callback/google"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-pro"
IMAGEN_MODEL="imagen-4.0-generate-001"

IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""
IMAGEKIT_FOLDER="/codexaa/presentations"

LOG_LEVEL="info"
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE="local"

WORKER_HEARTBEAT_INTERVAL_MS="10000"
WORKER_HEARTBEAT_TTL_MS="30000"
