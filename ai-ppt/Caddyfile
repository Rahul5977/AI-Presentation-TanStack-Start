www.kodexa.in {
  redir https://kodexa.in{uri} permanent
}

kodexa.in {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.paddle.com https://*.paddleedge.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.paddle.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: http:; connect-src 'self' https://*.paddle.com https://*.paddleedge.com https://ik.imagekit.io; frame-src https://*.paddle.com; object-src 'none'; base-uri 'self';"
  }

  @html {
    path /
    path /home
    path /login
    path /about-us
    path /about
    path /contact-us
    path /privacy-policy
    path /terms-and-conditions
    path /refund-and-cancellation-policy
    path /analytics
    path /presentation/*
    path /outline/*
    path /present/*
    path /share/*
  }
  header @html Cache-Control "no-cache, no-store, must-revalidate"

  @assets {
    path /assets/*
  }
  header @assets Cache-Control "public, max-age=31536000, immutable"

  # Load-balance across all `web` replicas. Docker DNS resolves the service name
  # to every replica IP; `dynamic a` re-resolves periodically and round-robins.
  # Passive retries skip a replica that's being recreated during a deploy.
  reverse_proxy {
    dynamic a {
      name web
      port 3000
      refresh 10s
    }
    lb_policy round_robin
    lb_try_duration 10s
    lb_try_interval 250ms
  }
}
