www.kodexa.in {
  redir https://kodexa.in{uri} permanent
}

kodexa.in {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://*.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: http:; connect-src 'self' https://api.razorpay.com https://*.razorpay.com https://ik.imagekit.io; frame-src https://api.razorpay.com https://*.razorpay.com; object-src 'none'; base-uri 'self';"
  }

  @html {
    path /
    path /home
    path /login
    path /about-us
    path /about
    path /contact-us
    path /privacy-policy
    path /terms-and-conditions
    path /refund-and-cancellation-policy
    path /analytics
    path /presentation/*
    path /outline/*
    path /present/*
    path /share/*
  }
  header @html Cache-Control "no-cache, no-store, must-revalidate"

  @assets {
    path /assets/*
  }
  header @assets Cache-Control "public, max-age=31536000, immutable"

  reverse_proxy web:3000 {
    health_uri /api/health/system
    health_interval 15s
    health_timeout 5s
  }
}
