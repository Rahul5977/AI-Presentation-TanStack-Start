# Production (Hostinger VPS, docker-compose.prod.yml)
BETTER_AUTH_URL="https://kodexa.in"
BETTER_AUTH_SECRET=""

DATABASE_URL="postgresql://postgres:***@postgres:5432/aippt?sslmode=disable"
DIRECT_URL="postgresql://postgres:***@postgres:5432/aippt?sslmode=disable"
RABBITMQ_URL="amqp://guest:guest@rabbitmq:5672"
REDIS_URL="redis://redis:6379"

POSTGRES_DB="aippt"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://kodexa.in/api/auth/callback/google"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-pro"
IMAGEN_MODEL="imagen-4.0-generate-001"

IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""
IMAGEKIT_FOLDER="/kodexa/prod"

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

LOG_LEVEL="info"
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_RELEASE="manual-prod"

WORKER_HEARTBEAT_INTERVAL_MS="10000"
WORKER_HEARTBEAT_TTL_MS="30000"

RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="30"
