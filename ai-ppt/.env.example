# --- Better Auth / OAuth ---
# Server base URL used to build OAuth callback URLs.
# Local: http://localhost:3000
# Production: https://kodexa.in
BETTER_AUTH_URL="http://localhost:3000"

# Optional client override for auth client base URL.
# Keep blank or same-origin in most cases.
# VITE_BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app credentials
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth app credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth callback URLs to register:
# - GitHub local:  http://localhost:3000/api/auth/callback/github
# - GitHub prod:   https://kodexa.in/api/auth/callback/github
# - Google local:  http://localhost:3000/api/auth/callback/google
# - Google prod:   https://kodexa.in/api/auth/callback/google
# - Optional www:  https://www.kodexa.in/api/auth/callback/{github|google}

# Neon — paste from Dashboard → Connect, or:
# npx neonctl connection-string --project-id shiny-heart-59233017
#
# P1001 "Can't reach database server": wake the DB in the Neon dashboard (SQL Editor),
# retry after ~30s (cold start), or check firewall/VPN blocking outbound port 5432.
#
# App — pooled URL is fine (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Prisma migrate / db push — MUST be direct (no "-pooler"). Without this, migrate uses DATABASE_URL and often hits P1001.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional alias some Neon templates use instead of DIRECT_URL:
# DATABASE_URL_UNPOOLED="postgresql://..."

# --- Google Gemini / Imagen (primary AI provider) ---
GEMINI_API_KEY=""
# Text model for outlines and slide content
GEMINI_MODEL="gemini-2.5-pro"
# Image generation model (Imagen 4 via Google AI Studio)
IMAGEN_MODEL="imagen-4.0-generate-001"
# Optional: alternative Gemini image model
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# AI provider switches:
# - AI_PROVIDER: global fallback for text+image
# - TEXT_PROVIDER / OUTLINE_PROVIDER: gemini | openai
# - IMAGE_PROVIDER: imagen | openai
AI_PROVIDER="gemini"
TEXT_PROVIDER="gemini"
OUTLINE_PROVIDER="gemini"
IMAGE_PROVIDER="imagen"

# --- OpenAI (optional) ---
OPENAI_API_KEY=""
OPENAI_OUTLINE_MODEL="gpt-4.1-mini"
OPENAI_SLIDE_MODEL="gpt-4.1-mini"
OPENAI_IMAGE_MODEL="gpt-image-1"
OPENAI_IMAGE_QUALITY="low"
OPENAI_IMAGE_SIZE="1536x1024"
# Model for the deck-level AI agent (function-calling). Needs OPENAI_API_KEY.
OPENAI_AGENT_MODEL="gpt-4.1-mini"

# --- RabbitMQ / Redis ---
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
REDIS_URL="redis://localhost:6380"
JOB_MAX_ATTEMPTS="5"
JOB_RETRY_BASE_MS="1500"
FINALIZE_RECHECK_MS="5000"

# --- AI orchestration runtime (src/server/ai/runtime) ---
# All optional; shown values are the defaults. Tune for your provider tiers/budget.

# Hard daily spend caps (USD). When reached, new generations are rejected at the
# enqueue gate AND inside callModel (429). Set GLOBAL low while testing.
GLOBAL_DAILY_USD_CAP="50"
USER_DAILY_USD_CAP="5"

# Set "false" to disable model fallback (use only the primary provider per op).
AI_FALLBACK_ENABLED="true"
# Slide-assistant chat primary provider (gemini | openai); falls back to the other.
SLIDE_CHAT_PROVIDER="gemini"
# Optional generic OpenAI text model override (else uses OPENAI_SLIDE_MODEL).
OPENAI_TEXT_MODEL="gpt-4.1-mini"

# Per-call timeouts (ms): text vs image generation.
AI_CALL_TIMEOUT_MS="60000"
AI_IMAGE_TIMEOUT_MS="120000"

# Circuit breaker: open a provider after N consecutive failures for a cooldown.
AI_BREAKER_THRESHOLD="5"
AI_BREAKER_COOLDOWN_MS="30000"

# Distributed concurrency cap per provider (Redis semaphore): text vs image.
AI_SEM_TEXT="8"
AI_SEM_IMAGE="3"
AI_SEM_LEASE_MS="180000"
AI_SEM_WAIT_MS="20000"

# Response cache TTL (ms) — identical prompts/retries return cached results free.
AI_CACHE_TTL_MS="86400000"

# Per-queue-class consumer prefetch (max unacked messages in flight per consumer).
AI_PREFETCH_OUTLINE="3"
AI_PREFETCH_CONTENT="5"
AI_PREFETCH_IMAGE="2"
AI_PREFETCH_UPLOAD="5"
AI_PREFETCH_FINALIZE="5"

# --- ImageKit ---
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
IMAGEKIT_FOLDER="/kodexa/presentations"

# --- Logging ---
LOG_LEVEL="info"

# ── Added in Phase 7 ─────────────────────────────────────────────────────────

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Google OAuth callback URL (register in Google Cloud Console)
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/callback/google"

# ImageKit account ID (shown in ImageKit dashboard as "imagekit_id")
IMAGEKIT_ID=""

# --- Plan quotas (monthly counters used for API hard limits) ---
PLAN_FREE_PRESENTATIONS_CREATED="5"
PLAN_FREE_SLIDES_GENERATED="60"
PLAN_FREE_EXPORTS="10"
PLAN_FREE_SOURCE_IMPORTS="10"
PLAN_FREE_SLIDE_ASSISTANT_REQUESTS="50"

PLAN_PRO_PRESENTATIONS_CREATED="200"
PLAN_PRO_SLIDES_GENERATED="4000"
PLAN_PRO_EXPORTS="500"
PLAN_PRO_SOURCE_IMPORTS="1000"
PLAN_PRO_SLIDE_ASSISTANT_REQUESTS="5000"

# --- Plan feature gates ---
# Max slides per generated deck. Free decks are capped; Pro effectively unlimited.
PLAN_FREE_MAX_SLIDES="10"
PLAN_PRO_MAX_SLIDES="100"
# Cheaper/faster text models used for the FREE tier (Pro uses GEMINI_MODEL / OPENAI_TEXT_MODEL).
GEMINI_FREE_MODEL="gemini-2.5-flash"
OPENAI_FREE_MODEL="gpt-4o-mini"

# --- Paddle subscription billing (Phase 2) ---
# Create a Paddle account (start in sandbox), a "Pro" product with monthly +
# annual prices, then fill these in. PADDLE_CLIENT_TOKEN is publishable (used by
# the browser checkout overlay); the others are secret. Leave empty to disable
# billing (the app still runs; everyone stays on the Free plan).
PADDLE_ENV="sandbox"                 # sandbox | production
PADDLE_API_KEY=""                    # server-side API key (secret)
PADDLE_CLIENT_TOKEN=""               # client-side token for Paddle.js (publishable)
PADDLE_WEBHOOK_SECRET=""             # webhook signing secret for /api/webhooks/paddle
PADDLE_PRICE_PRO_MONTHLY=""          # Paddle price id for Pro monthly ($12/mo)
PADDLE_PRICE_PRO_ANNUAL=""           # Paddle price id for Pro annual ($108/yr)

# Per-user short-window request throttling
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="30"

# Worker heartbeat for per-class health endpoints
WORKER_HEARTBEAT_INTERVAL_MS="10000"
WORKER_HEARTBEAT_TTL_MS="30000"

# Metrics endpoint protection. REQUIRED in production: when unset, /api/metrics
# is denied in production (fail-closed) and open only in local dev.
METRICS_TOKEN=""

# Owner accounts that bypass deck-payment gating (comma-separated emails).
# SECURITY: matched against the verified email ONLY — never the OAuth display
# name. Leave empty in production unless you really want a free-access account.
OWNER_EMAILS=""

# Sentry (web + worker)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE="local"

# Nightly backup settings (used by scripts/backup-postgres.sh)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="aippt"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
BACKUP_LOCAL_DIR="/var/backups/aippt"
BACKUP_RETENTION_DAYS="14"
# Example remote target: backup@storage-host:/srv/backups/aippt
BACKUP_REMOTE_TARGET=""
BACKUP_REMOTE_PORT="22"
