# --- Better Auth / OAuth ---
# Server base URL used to build OAuth callback URLs.
# Local: http://localhost:3000
# Production: https://codexaa.io
BETTER_AUTH_URL="http://localhost:3000"

# Optional client override for auth client base URL.
# Keep blank or same-origin in most cases.
# VITE_BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app credentials
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth app credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth callback URLs to register:
# - GitHub local:  http://localhost:3000/api/auth/callback/github
# - GitHub prod:   https://codexaa.io/api/auth/callback/github
# - Google local:  http://localhost:3000/api/auth/callback/google
# - Google prod:   https://codexaa.io/api/auth/callback/google
# - Optional www:  https://www.codexaa.io/api/auth/callback/{github|google}

# Neon — paste from Dashboard → Connect, or:
# npx neonctl connection-string --project-id shiny-heart-59233017
#
# P1001 "Can't reach database server": wake the DB in the Neon dashboard (SQL Editor),
# retry after ~30s (cold start), or check firewall/VPN blocking outbound port 5432.
#
# App — pooled URL is fine (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Prisma migrate / db push — MUST be direct (no "-pooler"). Without this, migrate uses DATABASE_URL and often hits P1001.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional alias some Neon templates use instead of DIRECT_URL:
# DATABASE_URL_UNPOOLED="postgresql://..."
